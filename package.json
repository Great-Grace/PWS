{
  "name": "app",
  "version": "1.0.0",
  "main": "scripts/native-only-command.js",
  "scripts": {
    "start": "node scripts/native-only-command.js npm-start",
    "android": "node scripts/native-only-command.js npm-run-android",
    "ios": "node scripts/native-only-command.js npm-run-ios",
    "web": "node scripts/native-only-command.js npm-run-web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "clean": "node scripts/native-only-command.js npm-run-clean",
    "clear-cache": "node scripts/native-only-command.js npm-run-clear-cache",
    "android:release": "node scripts/native-only-command.js npm-run-android-release",
    "native:android:test": "JAVA_HOME=\"$(node scripts/java21-home.js)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" apps/android-native/gradlew -p apps/android-native :app:testDebugUnitTest",
    "native:android:debug": "JAVA_HOME=\"$(node scripts/java21-home.js)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" apps/android-native/gradlew -p apps/android-native :app:assembleDebug",
    "native:android:release": "JAVA_HOME=\"$(node scripts/java21-home.js)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" apps/android-native/gradlew -p apps/android-native :app:assembleRelease",
    "native:android:verify": "JAVA_HOME=\"$(node scripts/java21-home.js)\" ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" apps/android-native/gradlew -p apps/android-native :app:testDebugUnitTest :app:assembleDebug :app:assembleRelease",
    "native:ios:build": "xcodebuild build -project apps/ios-native/PWSNativePreview.xcodeproj -scheme PWSNativePreview -destination 'generic/platform=iOS Simulator' -derivedDataPath apps/ios-native/.build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "native:ios:build-for-testing": "xcodebuild build-for-testing -project apps/ios-native/PWSNativePreview.xcodeproj -scheme PWSNativePreview -destination 'generic/platform=iOS Simulator' -derivedDataPath apps/ios-native/.build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "native:ios:verify": "npm run native:ios:build && npm run native:ios:build-for-testing",
    "native:readiness": "node scripts/native-readiness-report.js",
    "supabase:smoke": "node scripts/live-supabase-smoke.js",
    "testflight:accounts": "node scripts/setup-testflight-testers.js",
    "release:sbom": "node scripts/generate-npm-sbom.js",
    "release:readiness": "node scripts/release-readiness.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
